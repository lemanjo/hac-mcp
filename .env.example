# Compose image and host publication. Keep loopback unless trusted LAN clients need access.
MCP_IMAGE=home-assistant-admin-mcp:local
MCP_BIND_IP=127.0.0.1
MCP_PUBLISHED_PORT=3000

# The URL must be reachable from inside the container. On Linux, Compose maps
# host.docker.internal to the Docker host; a Home Assistant LAN IP also works.
HOME_ASSISTANT_URL=http://host.docker.internal:8123
HA_VERIFY_TLS=true
HA_REQUEST_TIMEOUT_MS=30000
HA_WEBSOCKET_TIMEOUT_MS=30000

# Host paths. HA_CONFIG_PATH is mounted read-write at /ha-config.
HA_CONFIG_PATH=/absolute/path/to/home-assistant/config
MCP_SETTINGS_FILE=./config.example.yaml
HA_TOKEN_SECRET_FILE=./secrets/home_assistant_token
MCP_TOKEN_SECRET_FILE=./secrets/mcp_auth_token

# Run as a non-root UID/GID that can read and write HA_CONFIG_PATH.
PUID=1000
PGID=1000

# read_only permits READ tools only; control adds CONTROL; admin adds all risks.
MCP_MODE=read_only

# Comma-separated Host header values accepted by the MCP HTTP server. Add every
# DNS name or IP that clients use, without a URL scheme.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,hac-mcp

# Comma-separated browser origin hostnames without scheme or port. Leave empty
# for non-browser MCP clients. Do not use a wildcard on an exposed deployment.
MCP_ALLOWED_ORIGINS=

# Filesystem and Git policy. Secret values and custom components default off.
HA_FILESYSTEM_ENABLED=true
HA_ALLOW_SECRET_VALUES=false
HA_ALLOW_CUSTOM_COMPONENTS=false
HA_GIT_ENABLED=true
